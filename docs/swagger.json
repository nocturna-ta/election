                "tags": [
                    "Election"
                ],
                "summary": "Election",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Authorized User",
                        "name": "X-User-Id",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "Authorized Address",
                        "name": "X-Address-Id",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "Authorized Role",
                        "name": "X-Role",
                        "in": "header"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/controller.jsonResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/response.ElectionPairListResponse"
                                        }
                                    }
